provider "azurerm" {
  features {}
}

resource "azurerm_resource_group" "atlas_rg" {
  name     = "rg-atlas-prod"
  location = "East US"
}

resource "azurerm_container_app_environment" "atlas_env" {
  name                = "cae-atlas-prod"
  location            = azurerm_resource_group.atlas_rg.location
  resource_group_name = azurerm_resource_group.atlas_rg.name
}

resource "azurerm_key_vault" "atlas_kv" {
  name                        = "kv-atlas-prod-9921"
  location                    = azurerm_resource_group.atlas_rg.location
  resource_group_name         = azurerm_resource_group.atlas_rg.name
  tenant_id                   = "00000000-0000-0000-0000-000000000000" # Placeholder
  sku_name                    = "standard"
  soft_delete_retention_days  = 7
  purge_protection_enabled    = false
}

# ==============================================================================
# A.T.L.A.S Environment Configuration Template
# ==============================================================================
# This is a TEMPLATE only. Real values are generated by the installer into
# ~/.atlas/.env (POSIX) or %USERPROFILE%\.atlas\.env (Windows) and never
# committed. To regenerate from scratch:  ./scripts/generate_env.py
#
# Copy this file to `.env` for manual development and fill in your API keys.

# ==============================================================================
# Runtime
# ==============================================================================
ATLAS_ENV=development                    # development | production
ATLAS_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
ATLAS_API_KEY=change-me                  # Added as a fallback header token

# Where the frontend is served. Traefik routes atlas.localhost -> frontend,
# api.atlas.localhost -> backend. For local dev without Traefik use these.
ATLAS_BACKEND_URL=http://localhost:8000
ATLAS_FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost

# ==============================================================================
# Auth (JWT) — installer generates strong random secrets; do not commit.
# ==============================================================================
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# First admin account seeded on a fresh DB (only used by init scripts).
ATLAS_BOOTSTRAP_ADMIN_EMAIL=admin@atlas.local
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=change-me

# ==============================================================================
# Databases
# ==============================================================================
POSTGRES_HOST=postgres                   # service name inside compose; localhost on host
POSTGRES_PORT=5432
POSTGRES_USER=atlas_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ==============================================================================
# Object storage (MinIO) — backup target
# ==============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=atlas-backups
MINIO_SECURE=false

# Backup encryption (AES-256-GCM). Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ATLAS_BACKUP_KEY=change-me-to-32-bytes-base64
ATLAS_BACKUP_SCHEDULE=0 2 * * *          # cron: nightly 02:00
ATLAS_BACKUP_RETENTION=14                # keep last N backups

# ==============================================================================
# LLM Providers (optional — agents degrade gracefully without these)
# ==============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# Speech & Voice (optional)
# ==============================================================================
ELEVENLABS_API_KEY=
PORCUPINE_ACCESS_KEY=
WHISPER_MODEL_PATH=base                  # tiny | base | small | medium | large-v3
OLLAMA_BASE_URL=http://ollama:11434

# ==============================================================================
# GPU (opt-in)
# ==============================================================================
ATLAS_ENABLE_GPU=false                   # set true + use --profile gpu to enable
